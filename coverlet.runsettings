<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Exclude>[*]AspNetCoreGeneratedDocument.*,[*]*Migration*,[*]Program</Exclude>
          <ExcludeByFile>**/Migrations/*,**/wwwroot/*,**/*.cshtml</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
