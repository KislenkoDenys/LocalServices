				{
					"name": "1.2 Створити нову категорію (POST 201)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var data = pm.response.json();",
									"    if (data && data.id) {",
									"        pm.collectionVariables.set(\"testCategoryId\", data.id);",
									"        pm.environment.set(\"testCategoryId\", data.id);",
									"        pm.globals.set(\"testCategoryId\", data.id);",
									"    }",
									"}",
									"",
									"pm.test(\"Статус відповіді 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Створена категорія має валідний ID та назву\", function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data).to.have.property(\"id\");",
									"    pm.expect(data.id).to.be.above(0);",
									"    pm.expect(data.name).to.eql(\"Тестова Категорія Postman\");",
