@model LocalServices.Models.Service

@{
    ViewData["Title"] = $"Послуга: {Model.Name}";
    var facilityAddress = string.Join(", ", new[] { Model.Facility?.City, Model.Facility?.Street }.Where(s => !string.IsNullOrWhiteSpace(s)));
}

<style>
    html {
        scroll-behavior: smooth;
    }
    .sticky-service-box {
        position: sticky;
        top: 80px;
    }
    .facility-card-img {
        max-height: 200px;
        width: 100%;
        object-fit: cover;
        border-radius: 0.5rem;
    }
</style>

<div class="container py-3">
    <!-- Заголовок сторінки -->
    <div class="d-flex flex-wrap align-items-center justify-content-between border-bottom pb-3 mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">@Model.Name</h1>
            <span class="badge bg-success fs-6 px-3 py-1 rounded-pill">
                Послуга
            </span>
            @if (Model.Facility?.Category != null)
            {
                <span class="badge bg-secondary fs-6 px-3 py-1 rounded-pill ms-1">
                    @Model.Facility.Category.Name
                </span>
            }
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm me-1">Редагувати</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">До списку послуг</a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Ліва колонка: Деталі послуги та заклад зі скролом -->
        <div class="col-lg-8">
            
            <!-- Картка вартості послуги -->
            <div class="card border-0 shadow-sm rounded-3 mb-4 bg-primary bg-opacity-10 border-start border-primary border-4">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase mb-1">Вартість послуги</div>
                        <h2 class="display-6 fw-bold text-primary mb-0">@Model.Price.ToString("N2") ₴</h2>
                    </div>
                    <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">
                        Фіксована ціна
                    </span>
                </div>
            </div>

            <!-- Інформація про заклад, що надає послугу -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-body p-4">
                    <h4 class="card-title fw-bold text-dark mb-3">Заклад, що надає послугу</h4>

                    @if (Model.Facility != null)
                    {
                        @if (!string.IsNullOrEmpty(Model.Facility.ImagePath))
                        {
                            <div class="mb-3">
                                <img src="@Model.Facility.ImagePath" alt="@Model.Facility.Name" class="facility-card-img shadow-sm" />
                            </div>
                        }

                        <h5 class="fw-bold text-dark mb-2">@Model.Facility.Name</h5>

                        @if (!string.IsNullOrWhiteSpace(Model.Facility.Description))
                        {
                            <p class="text-secondary small mb-3">
                                @Model.Facility.Description
                            </p>
                        }

                        <div class="row g-2 mb-3">
                            <div class="col-sm-6">
                                <div class="p-2 rounded bg-light small">
                                    <span class="text-muted">Адреса:</span>
                                    <div class="fw-semibold text-dark">
                                        @(string.IsNullOrWhiteSpace(facilityAddress) ? "Не вказано" : facilityAddress)
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-2 rounded bg-light small">
                                    <span class="text-muted">Телефон:</span>
                                    <div class="fw-semibold text-dark">
                                        @(string.IsNullOrWhiteSpace(Model.Facility.Phone) ? "Не вказано" : Model.Facility.Phone)
                                    </div>
                                </div>
                            </div>
                        </div>

                        <a asp-controller="Facilities" asp-action="Details" asp-route-id="@Model.Facility.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                            Перейти на сторінку закладу →
                        </a>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">Заклад не вказано або видалено.</p>
                    }
                </div>
            </div>

        </div>

        <!-- Права колонка: Контакти та зведена інформація (STICKY) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 sticky-service-box bg-light">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Деталі</h5>

                    <div class="mb-3">
                        <label class="text-muted small fw-bold text-uppercase">Назва послуги</label>
                        <div class="fs-5 fw-bold text-dark">@Model.Name</div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small fw-bold text-uppercase">Ціна</label>
                        <div class="fs-4 fw-bold text-success">@Model.Price.ToString("N2") ₴</div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small fw-bold text-uppercase">Заклад</label>
                        <div class="text-dark fw-semibold">
                            @(Model.Facility?.Name ?? "Не вказано")
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Facility?.Phone))
                    {
                        <div class="mb-3">
                            <label class="text-muted small fw-bold text-uppercase">Телефон закладу</label>
                            <div class="text-dark fw-bold">@Model.Facility.Phone</div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Facility?.WorkingHours))
                    {
                        <div class="mb-3">
                            <label class="text-muted small fw-bold text-uppercase">Години роботи</label>
                            <div class="text-dark">@Model.Facility.WorkingHours</div>
                        </div>
                    }

                    <div class="mb-4">
                        <label class="text-muted small fw-bold text-uppercase">Адреса</label>
                        <div class="text-dark">
                            @(string.IsNullOrWhiteSpace(facilityAddress) ? "Не вказано" : facilityAddress)
                        </div>
                    </div>

                    <!-- Кнопки дій -->
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                            Редагувати послугу
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Назад до списку
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
