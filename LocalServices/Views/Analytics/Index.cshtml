@model LocalServices.Models.AnalyticsViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Статистика та аналітика";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Статистика та аналітика сервісу</h1>
            <p class="text-muted small mb-0">Візуалізація структури каталогу, географії закладів та цінової політики</p>
        </div>
        <div class="mt-2 mt-md-0">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                Оновити дані
            </a>
        </div>
    </div>

    <!-- KPI Cards (Server-Rendered) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 border-start border-4 border-primary shadow-sm rounded-3 h-100 bg-light">
                <div class="card-body p-3">
                    <div class="text-muted small fw-medium text-uppercase mb-1">Усього закладів</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalFacilities</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 border-start border-4 border-success shadow-sm rounded-3 h-100 bg-light">
                <div class="card-body p-3">
                    <div class="text-muted small fw-medium text-uppercase mb-1">Категорій послуг</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalCategories</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 border-start border-4 border-warning shadow-sm rounded-3 h-100 bg-light">
                <div class="card-body p-3">
                    <div class="text-muted small fw-medium text-uppercase mb-1">Усього послуг</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalServices</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 border-start border-4 border-info shadow-sm rounded-3 h-100 bg-light">
                <div class="card-body p-3">
                    <div class="text-muted small fw-medium text-uppercase mb-1">Середня ціна</div>
                    <div class="fs-4 fw-bold text-dark">@Model.AverageServicePrice.ToString("N2") ₴</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Container -->
    <div class="row g-4 mb-4">
        <!-- Doughnut Chart: Categories -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold text-dark mb-1">Розподіл закладів за категоріями</h2>
                    <p class="text-muted small mb-3">Частка кожної категорії у структурі сервісу</p>
                    <div style="position: relative; height: 300px;">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bar Chart: Cities -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold text-dark mb-1">Географія закладів</h2>
                    <p class="text-muted small mb-3">Кількість закладів у розрізі міст України</p>
                    <div style="position: relative; height: 300px;">
                        <canvas id="cityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Horizontal Bar Chart: Average Price by Category -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold text-dark mb-1">Середня вартість послуг за категоріями (₴)</h2>
                    <p class="text-muted small mb-3">Порівняння середньої вартості послуг у різних сферах діяльності</p>
                    <div style="position: relative; height: 280px;">
                        <canvas id="priceChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const categoriesData = @Html.Raw(JsonSerializer.Serialize(Model.FacilitiesByCategory));
            const citiesData = @Html.Raw(JsonSerializer.Serialize(Model.FacilitiesByCity));
            const priceData = @Html.Raw(JsonSerializer.Serialize(Model.PriceByCategory));

            const palette = [
                '#0d6efd', '#198754', '#ffc107', '#0dcaf0', 
                '#6f42c1', '#d63384', '#fd7e14', '#20c997'
            ];

            // 1. Doughnut Chart: Categories
            const catCtx = document.getElementById('categoryChart').getContext('2d');
            new Chart(catCtx, {
                type: 'doughnut',
                data: {
                    labels: categoriesData.map(x => x.Label),
                    datasets: [{
                        data: categoriesData.map(x => x.Count),
                        backgroundColor: palette.slice(0, categoriesData.length),
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 14, font: { size: 12 } }
                        }
                    }
                }
            });

            // 2. Bar Chart: Cities
            const cityCtx = document.getElementById('cityChart').getContext('2d');
            new Chart(cityCtx, {
                type: 'bar',
                data: {
                    labels: citiesData.map(x => x.Label),
                    datasets: [{
                        label: 'Кількість закладів',
                        data: citiesData.map(x => x.Count),
                        backgroundColor: '#0d6efd',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // 3. Horizontal Bar Chart: Price by Category
            const priceCtx = document.getElementById('priceChart').getContext('2d');
            new Chart(priceCtx, {
                type: 'bar',
                data: {
                    labels: priceData.map(x => x.Category),
                    datasets: [{
                        label: 'Середня ціна (₴)',
                        data: priceData.map(x => x.AvgPrice),
                        backgroundColor: '#198754',
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) { return value + ' ₴'; }
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function (context) { return `Середня ціна: ${context.parsed.x.toFixed(2)} ₴`; }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
