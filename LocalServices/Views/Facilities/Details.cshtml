@model LocalServices.Models.Facility

@{
    var cityName = string.IsNullOrWhiteSpace(Model.City) ? "Україна" : Model.City;
    var categoryName = Model.Category?.Name ?? "Заклад";
    var pageTitle = $"{Model.Name} — {categoryName} у місті {cityName}";
    ViewData["Title"] = pageTitle;

    var fullAddress = string.Join(", ", new[] { Model.City, Model.Street }.Where(s => !string.IsNullOrWhiteSpace(s)));
    if (string.IsNullOrWhiteSpace(fullAddress))
    {
        fullAddress = "Адреса уточнюється";
    }

    var metaDesc = !string.IsNullOrWhiteSpace(Model.Description) && Model.Description.Length >= 40
        ? (Model.Description.Length > 150 ? Model.Description.Substring(0, 147) + "..." : Model.Description)
        : $"Заклад {Model.Name} ({categoryName}) у місті {cityName}: адреса {fullAddress}, актуальні послуги, ціни, графік роботи та контакти.";
    ViewData["MetaDescription"] = metaDesc;
    ViewData["CanonicalUrl"] = $"https://localservices-ecv8.onrender.com/Facilities/Details/{Model.Id}";
}

@section MetaTags {
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@metaDesc" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://localservices-ecv8.onrender.com/Facilities/Details/@Model.Id" />
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <meta property="og:image" content="@Model.ImagePath" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@metaDesc" />

    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "LocalBusiness",
        "name": "@Model.Name",
        "description": "@(string.IsNullOrWhiteSpace(Model.Description) ? metaDesc : Model.Description.Replace("\"", "\\\"").Replace("\r", "").Replace("\n", " "))",
        "telephone": "@(string.IsNullOrWhiteSpace(Model.Phone) ? "+380000000000" : Model.Phone)",
        "openingHours": "@(string.IsNullOrWhiteSpace(Model.WorkingHours) ? "Mo-Su 09:00-21:00" : Model.WorkingHours)",
        "address": {
            "@@type": "PostalAddress",
            "addressLocality": "@cityName",
            "streetAddress": "@(Model.Street ?? "")"
        }
    }
    </script>
}

<style>
    html {
        scroll-behavior: smooth;
    }
    .sticky-contact-box {
        position: sticky;
        top: 80px;
    }
    .facility-hero-img {
        max-height: 380px;
        width: 100%;
        object-fit: cover;
        border-radius: 0.75rem;
    }
</style>

<div class="container py-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between border-bottom pb-3 mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">
                @Model.Name — @categoryName у місті @cityName
            </h1>
            <span class="badge bg-primary fs-6 px-3 py-1 rounded-pill">
                @categoryName
            </span>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm me-1">Редагувати картку</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Каталог закладів</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="mb-4">
                    <img src="@Model.ImagePath" 
                         alt="Фото закладу @Model.Name, @categoryName у місті @cityName" 
                         class="facility-hero-img shadow-sm" />
                </div>
            }

            <section class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-body p-4">
                    <h2 class="h4 card-title fw-bold text-dark mb-3">Детальна інформація про заклад</h2>
                    
                    <p class="card-text text-secondary leading-relaxed mb-3">
                        Заклад <strong>@Model.Name</strong> є провідним представником у категорії <strong>@categoryName</strong> у місті <strong>@cityName</strong>. 
                        Зручне розташування за адресою <em>@fullAddress</em> забезпечує швидкий та комфортний доступ як для постійних жителів, 
                        так і для гостей міста @cityName. Наша мета — надати кожному клієнту сервіс найвищої якості та індивідуальний підхід.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="card-text text-secondary leading-relaxed mb-3" style="white-space: pre-line;">
                            @Model.Description
                        </p>
                    }

                    <p class="card-text text-secondary leading-relaxed mb-3">
                        Обираючи <strong>@Model.Name</strong>, ви довіряєте свій час та комфорт професіоналам своєї справи. 
                        Заклад пропонує комплексний спектр послуг, що охоплює популярні запити у напрямку @categoryName. 
                        Сучасне оснащення, уважний кваліфікований персонал, дотримання високих стандартів якості та безпеки гарантують 
                        відмінний результат при кожному зверненні у місті @cityName.
                    </p>

                    <p class="card-text text-secondary leading-relaxed mb-3">
                        Для вашої зручності заклад @Model.Name у місті @cityName працює за гнучким графіком: 
                        <strong>@(string.IsNullOrWhiteSpace(Model.WorkingHours) ? "щоденно у зручний час" : Model.WorkingHours)</strong>. 
                        Ви завжди можете заздалегідь спланувати свій візит або уточнити актуальну вартість та наявність вільних місць 
                        за контактним номером телефону <strong>@(string.IsNullOrWhiteSpace(Model.Phone) ? "зазначеним у профілі" : Model.Phone)</strong>.
                    </p>

                    <div class="bg-light p-3 rounded-3 border-start border-primary border-4 my-3">
                        <h3 class="h6 fw-bold text-dark mb-2">Переваги відвідування @Model.Name</h3>
                        <p class="text-secondary small mb-2">
                            • Зручне розташування в доступній частині міста @cityName за адресою @fullAddress.
                        </p>
                        <p class="text-secondary small mb-2">
                            • Широкий перелік перевірених послуг у категорії @categoryName з чесними та прозорими цінами.
                        </p>
                        <p class="text-secondary small mb-2">
                            • Клієнтоорієнтований сервіс, пунктуальність та висока кваліфікація команди спеціалістів.
                        </p>
                        <p class="text-secondary small mb-0">
                            • Актуальний прайс-лист на послуги, який регулярно оновлюється та представлений у таблиці нижче.
                        </p>
                    </div>

                    <p class="card-text text-secondary leading-relaxed mb-0">
                        Ознайомтеся з детальним переліком послуг та цін закладу @Model.Name нижче на цій сторінці. 
                        Якщо у вас виникли запитання щодо послуг у категорії @categoryName або ви бажаєте завітати до нас у місті @cityName, 
                        використовуйте контакти з бічного інформаційного блоку для швидкого зв'язку.
                    </p>
                </div>
            </section>

            <section class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h4 card-title fw-bold text-dark mb-0">Послуги та ціни</h2>
                        <span class="badge bg-secondary rounded-pill">
                            Кількість: @(Model.Services?.Count ?? 0)
                        </span>
                    </div>

                    @if (Model.Services != null && Model.Services.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Назва послуги</th>
                                        <th scope="col" class="text-end">Ціна</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var service in Model.Services)
                                    {
                                        <tr>
                                            <td class="fw-medium text-dark">@service.Name</td>
                                            <td class="text-end fw-bold text-success fs-5">
                                                @service.Price.ToString("N2") ₴
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">Послуги для цього закладу ще не додані.</p>
                    }
                </div>
            </section>
        </div>

        <aside class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 sticky-contact-box bg-light">
                <div class="card-body p-4">
                    <h3 class="h5 fw-bold text-dark border-bottom pb-2 mb-3">Контакти закладу</h3>

                    <div class="mb-3">
                        <span class="text-muted small fw-bold text-uppercase d-block">Номер телефону</span>
                        <div class="fs-5 fw-bold text-dark">
                            @(string.IsNullOrWhiteSpace(Model.Phone) ? "Не вказано" : Model.Phone)
                        </div>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted small fw-bold text-uppercase d-block">Години роботи</span>
                        <div class="text-dark">
                            @(string.IsNullOrWhiteSpace(Model.WorkingHours) ? "Не вказано" : Model.WorkingHours)
                        </div>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted small fw-bold text-uppercase d-block">Місто</span>
                        <div class="text-dark">
                            @(string.IsNullOrWhiteSpace(Model.City) ? "Не вказано" : Model.City)
                        </div>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted small fw-bold text-uppercase d-block">Вулиця та номер</span>
                        <div class="text-dark">
                            @(string.IsNullOrWhiteSpace(Model.Street) ? "Не вказано" : Model.Street)
                        </div>
                    </div>

                    <div class="mb-4">
                        <span class="text-muted small fw-bold text-uppercase d-block">Категорія</span>
                        <div class="text-dark">
                            @categoryName
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a href="https://maps.google.com/?q=@Uri.EscapeDataString(Model.Name + " " + cityName + " " + (Model.Street ?? ""))" 
                           target="_blank" 
                           rel="noopener noreferrer" 
                           class="btn btn-outline-success">
                            Знайти на Google Maps
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                            Оновити інформацію
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Повернутися до каталогу
                        </a>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>
