@model LocalServices.Models.Facility

@{
    ViewData["Title"] = "Створити заклад";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h1 class="h3 fw-bold text-dark mb-0">Створити заклад</h1>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Повернутися до списку</a>
    </div>

    <form asp-action="Create" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="alert alert-danger mb-3" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-body p-4">
                        <h2 class="h5 fw-bold text-dark mb-3">Основна інформація</h2>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-medium"></label>
                            <input asp-for="Name" class="form-control" required placeholder="Наприклад: Кав'ярня Аромат" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label fw-medium"></label>
                                <input asp-for="City" id="cityInput" class="form-control" placeholder="Київ" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Street" class="form-label fw-medium"></label>
                                <input asp-for="Street" id="streetInput" class="form-control" placeholder="вул. Хрещатик, 1" />
                                <span asp-validation-for="Street" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-medium"></label>
                                <input asp-for="Phone" class="form-control" placeholder="+380..." />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="WorkingHours" class="form-label fw-medium"></label>
                                <input asp-for="WorkingHours" class="form-control" placeholder="Пн-Нд 09:00 - 21:00" />
                                <span asp-validation-for="WorkingHours" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-medium">Категорія <span class="text-danger">*</span></label>
                            @{
                                var selectedCategoryName = ViewBag.SelectedCategoryName as string;
                            }
                            <select asp-for="CategoryId" id="categorySelect" class="form-select" required>
                                @if (!string.IsNullOrEmpty(selectedCategoryName) && Model != null && Model.CategoryId > 0)
                                {
                                    <option value="@Model.CategoryId" selected>@selectedCategoryName</option>
                                }
                                else
                                {
                                    <option value="">-- Оберіть або знайдіть категорію --</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-medium"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Опис закладу та його послуг"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Фотографія закладу</label>
                            
                            <div id="fileDropZone" class="p-3 text-center rounded-3 mb-2" style="border: 2px dashed #ced4da; cursor: pointer; transition: all 0.2s ease; background-color: #fbfbfb;">
                                <div id="dropZonePrompt" class="py-2">
                                    <div class="mb-1" style="font-size: 1.6rem; color: #6c757d;">📁</div>
                                    <div class="fw-medium text-dark small">Перетягніть фото сюди або <span class="text-primary text-decoration-underline">оберіть файл</span></div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Підтримуються JPG, PNG, WEBP (до 5 МБ)</div>
                                </div>
                                <div id="filePreviewContainer" class="d-none py-1">
                                    <div class="d-flex align-items-center gap-3 text-start">
                                        <img id="imagePreview" src="" alt="Прев'ю" style="width: 70px; height: 70px; object-fit: cover; border-radius: 0.375rem; border: 1px solid #dee2e6;" />
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div id="fileNameDisplay" class="fw-medium text-dark text-truncate small"></div>
                                            <div id="fileMetaDisplay" class="text-muted" style="font-size: 0.75rem;"></div>
                                            <button type="button" id="btnRemoveFile" class="btn btn-link text-danger p-0 mt-1" style="font-size: 0.75rem; text-decoration: none;">Видалити фото</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div id="fileErrorAlert" class="alert alert-danger py-1 px-2 small d-none mb-2" role="alert"></div>

                            <input asp-for="ImageFile" id="facilityImageInput" type="file" class="d-none" accept="image/*"/>
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h2 class="h5 fw-bold text-dark mb-0">Розташування на мапі</h2>
                            <button type="button" id="btnGeocode" class="btn btn-primary btn-sm">
                                Знайти за адресою
                            </button>
                        </div>
                        <p class="text-muted small mb-3">
                            Введіть місто та вулицю зліва і натисніть «Знайти за адресою» або просто клікніть у потрібну точку на карті.
                        </p>

                        <div id="geocodeAlert" class="alert d-none small py-2 px-3 mb-3" role="alert"></div>

                        <div id="facilityMiniMap" style="height: 320px; border-radius: 0.5rem; border: 1px solid #dee2e6;" class="mb-3"></div>

                        <div class="row g-2">
                            <div class="col-6">
                                <label asp-for="Latitude" class="form-label small text-muted mb-1">Широта (Lat)</label>
                                <input asp-for="Latitude" id="latitudeInput" class="form-control form-control-sm" readonly />
                            </div>
                            <div class="col-6">
                                <label asp-for="Longitude" class="form-label small text-muted mb-1">Довгота (Lng)</label>
                                <input asp-for="Longitude" id="longitudeInput" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <input type="submit" value="Зберегти заклад" class="btn btn-success btn-lg fw-bold" />
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/uk.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            $('#categorySelect').select2({
                theme: 'bootstrap-5',
                language: {
                    inputTooShort: function () { return ''; },
                    noResults: function () { return 'Нічого не знайдено'; },
                    searching: function () { return 'Пошук...'; }
                },
                placeholder: 'Почніть вводити назву категорії (від 3 символів)...',
                allowClear: true,
                width: '100%',
                minimumInputLength: 3,
                ajax: {
                    url: '/api/categories/search',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term || '',
                            page: params.page || 1,
                            pageSize: 10
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.results,
                            pagination: {
                                more: data.pagination ? data.pagination.more : false
                            }
                        };
                    },
                    cache: true
                }
            });
            const defaultLat = 50.4501;
            const defaultLng = 30.5234;

            const latInput = document.getElementById("latitudeInput");
            const lngInput = document.getElementById("longitudeInput");
            const cityInput = document.getElementById("cityInput");
            const streetInput = document.getElementById("streetInput");
            const btnGeocode = document.getElementById("btnGeocode");
            const alertBox = document.getElementById("geocodeAlert");

            let currentLat = parseFloat(latInput.value) || defaultLat;
            let currentLng = parseFloat(lngInput.value) || defaultLng;

            latInput.value = currentLat.toFixed(6);
            lngInput.value = currentLng.toFixed(6);

            const map = L.map('facilityMiniMap').setView([currentLat, currentLng], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            let marker = L.marker([currentLat, currentLng], { draggable: true }).addTo(map);

            function updateCoords(lat, lng) {
                latInput.value = lat.toFixed(6);
                lngInput.value = lng.toFixed(6);
                marker.setLatLng([lat, lng]);
            }

            async function reverseGeocode(lat, lng) {
                try {
                    const url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&addressdetails=1`;
                    const res = await fetch(url, { headers: { 'Accept-Language': 'uk' } });
                    const data = await res.json();
                    if (data && data.address) {
                        const addr = data.address;
                        const detectedCity = addr.city || addr.town || addr.village || addr.municipality || "";
                        const streetName = addr.road || addr.pedestrian || addr.square || addr.footway || addr.neighbourhood || "";
                        const houseNumber = addr.house_number || "";
                        const fullStreet = [streetName, houseNumber].filter(Boolean).join(", ");

                        if (detectedCity) {
                            cityInput.value = detectedCity;
                        }
                        if (fullStreet) {
                            streetInput.value = fullStreet;
                        }

                        const summary = [detectedCity || cityInput.value, fullStreet].filter(Boolean).join(", ");
                        if (summary) {
                            showAlert("info", `Адресу автоматично заповнено: ${summary}`);
                        }
                    }
                } catch (err) {
                    console.warn("Помилка зворотного геокодування:", err);
                }
            }

            marker.on('dragend', function (e) {
                const pos = marker.getLatLng();
                updateCoords(pos.lat, pos.lng);
                reverseGeocode(pos.lat, pos.lng);
            });

            map.on('click', function (e) {
                updateCoords(e.latlng.lat, e.latlng.lng);
                reverseGeocode(e.latlng.lat, e.latlng.lng);
            });

            function showAlert(type, message) {
                alertBox.className = `alert alert-${type} small py-2 px-3 mb-3`;
                alertBox.textContent = message;
                alertBox.classList.remove("d-none");
            }

            function hideAlert() {
                alertBox.classList.add("d-none");
            }

            btnGeocode.addEventListener("click", async function () {
                const city = cityInput.value.trim();
                const street = streetInput.value.trim();

                if (!city && !street) {
                    showAlert("warning", "Будь ласка, вкажіть місто та вулицю для пошуку.");
                    return;
                }

                const query = [street, city, "Україна"].filter(Boolean).join(", ");
                btnGeocode.disabled = true;
                btnGeocode.textContent = "Пошук...";

                try {
                    const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1`;
                    const res = await fetch(url, { headers: { 'Accept-Language': 'uk' } });
                    const data = await res.json();

                    if (data && data.length > 0) {
                        const newLat = parseFloat(data[0].lat);
                        const newLng = parseFloat(data[0].lon);
                        updateCoords(newLat, newLng);
                        map.setView([newLat, newLng], 16);
                        showAlert("success", `Адресу знайдено: ${data[0].display_name}`);
                        if (!streetInput.value.trim()) {
                            reverseGeocode(newLat, newLng);
                        }
                    } else {
                        showAlert("danger", "Вказану адресу не знайдено на мапі. Перевірте правильність написання або вкажіть розташування кліком на карті.");
                    }
                } catch (err) {
                    showAlert("danger", "Не вдалося з'єднатися з картографічним сервісом. Будь ласка, оберіть точку кліком на карті.");
                } finally {
                    btnGeocode.disabled = false;
                    btnGeocode.textContent = "Знайти за адресою";
                }
            });

            const dropZone = document.getElementById("fileDropZone");
            const fileInput = document.getElementById("facilityImageInput");
            const promptBox = document.getElementById("dropZonePrompt");
            const previewBox = document.getElementById("filePreviewContainer");
            const previewImg = document.getElementById("imagePreview");
            const nameDisplay = document.getElementById("fileNameDisplay");
            const metaDisplay = document.getElementById("fileMetaDisplay");
            const btnRemove = document.getElementById("btnRemoveFile");
            const errorAlert = document.getElementById("fileErrorAlert");

            function showFileError(msg) {
                errorAlert.textContent = msg;
                errorAlert.classList.remove("d-none");
            }

            function clearFileError() {
                errorAlert.textContent = "";
                errorAlert.classList.add("d-none");
            }

            function handleFile(file) {
                clearFileError();
                if (!file) return;

                if (!file.type.startsWith("image/")) {
                    showFileError("Обраний файл не є зображенням. Підтримуються лише JPG, PNG, WEBP.");
                    return;
                }

                const maxSize = 5 * 1024 * 1024;
                if (file.size > maxSize) {
                    showFileError(`Розмір файлу (${(file.size / (1024 * 1024)).toFixed(1)} МБ) перевищує допустимий ліміт 5 МБ.`);
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    previewImg.src = e.target.result;
                    nameDisplay.textContent = file.name;
                    metaDisplay.textContent = `${(file.size / 1024).toFixed(1)} КБ • ${file.type}`;
                    promptBox.classList.add("d-none");
                    previewBox.classList.remove("d-none");
                };
                reader.readAsDataURL(file);

                const dt = new DataTransfer();
                dt.items.add(file);
                fileInput.files = dt.files;
            }

            dropZone.addEventListener("click", () => fileInput.click());

            fileInput.addEventListener("change", function () {
                if (this.files && this.files[0]) {
                    handleFile(this.files[0]);
                }
            });

            ["dragenter", "dragover"].forEach(evtName => {
                dropZone.addEventListener(evtName, function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.style.borderColor = "#0d6efd";
                    dropZone.style.backgroundColor = "#e7f1ff";
                });
            });

            ["dragleave", "drop"].forEach(evtName => {
                dropZone.addEventListener(evtName, function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.style.borderColor = "#ced4da";
                    dropZone.style.backgroundColor = "#fbfbfb";
                });
            });

            dropZone.addEventListener("drop", function (e) {
                if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
                    handleFile(e.dataTransfer.files[0]);
                }
            });

            btnRemove.addEventListener("click", function (e) {
                e.stopPropagation();
                fileInput.value = "";
                previewImg.src = "";
                promptBox.classList.remove("d-none");
                previewBox.classList.add("d-none");
                clearFileError();
            });
        });
    </script>
}
