@model IEnumerable<LocalServices.Models.Facility>

@{
    ViewData["Title"] = "Заклади";
}

<h1>Заклади</h1>

<p>
    <a asp-action="Create">Створити новий</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImagePath)
            </th>
            <th>
                Адреса
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @if (!string.IsNullOrEmpty(item.ImagePath))
                {
                    <img src="@item.ImagePath" alt="@item.Name" style="max-height: 50px; max-width: 80px; object-fit: cover;" />
                }
                else
                {
                    <span>Немає фото</span>
                }
            </td>
            <td>
                @if (!string.IsNullOrWhiteSpace(item.City) || !string.IsNullOrWhiteSpace(item.Street))
                {
                    @string.Join(", ", new[] { item.City, item.Street }.Where(s => !string.IsNullOrWhiteSpace(s)))
                }
                else
                {
                    <span>—</span>
                }
            </td>
            <td>
                @item.Category?.Name
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Редагувати</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Деталі</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Видалити</a>
            </td>
        </tr>
}
    </tbody>
</table>
